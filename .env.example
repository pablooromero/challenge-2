APP_NAME=FADUA BI Assistant
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Si front y back viven en el mismo servicio, esta variable casi no interviene.
# Solo hace falta cambiarla si despues separas la UI y la API en dominios distintos.
APP_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BACKOFF_SECONDS=0.75

MYSQL_HOST=193.203.175.134
MYSQL_PORT=3306
MYSQL_DB=u420581741_pruebas
MYSQL_USER=u420581741_pruebas
MYSQL_PASSWORD=your-mysql-password
MYSQL_TABLE=metricas_campanas_ventas
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=10
MYSQL_WRITE_TIMEOUT=10

LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=300
